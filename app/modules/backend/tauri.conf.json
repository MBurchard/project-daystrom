{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Project Daystrom",
  "version": "../../../package.json",
  "identifier": "mbur.project-daystrom",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Project Daystrom",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../resources/mod/*": "mod/"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MBurchard/project-daystrom/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERDdDQTU5OTY0MDVDNDQKUldSRVhFQ1dXY3JYN2VYVWoxQmpmbmhlQi9tcnhOSnhGMlR4VkREWDcrZWM5Q3NkSlNxbWRIM2IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
